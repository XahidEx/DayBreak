# --- Database (local dev; docker-compose overrides DATABASE_URL) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://daybreak:change-me@localhost:5432/daybreak

# --- Auth ---
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
COOKIE_SECURE=false   # set true once you serve over HTTPS

# --- Market data (Financial Modeling Prep) ---
FMP_API_KEY=

# --- AI summary (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Email (any SMTP; Resend: smtp.resend.com, port 465, SMTP_SECURE=true, user "resend", pass = API key) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DayBreak <daybreak@yourdomain.com>
ADMIN_EMAIL=you@example.com   # gets an email if a morning run fails

# --- Schedule: 07:00 Gulf time Tue-Sat (covers US sessions Mon-Fri) ---
BRIEF_CRON=0 7 * * 2-6
BRIEF_TZ=Asia/Dubai
MOVE_THRESHOLD_PCT=3

# --- Dead-man's switch: create a check at healthchecks.io (period 1 day, grace 2h; set days Tue-Sat via cron schedule) ---
HEALTHCHECK_URL=
